{
  "manifest_version": 3,
  "name": "Reset Beer — AI Quota Reset Alerts",
  "version": "1.0.0",
  "description": "Real-time AI quota reset alerts. Track Codex, Claude, Gemini, Cursor + 11 more. Never waste paid credits again.",
  "permissions": ["storage", "alarms", "notifications"],
  "host_permissions": ["https://reset.beer/*"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
